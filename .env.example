# Copiar a .env y rellenar desde Connect / API del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web: http://localhost:8081. Android development build: apex://auth/recovery
# Debe estar permitido en Auth > URL Configuration. Usar una URL por plataforma.
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081/auth/invite
# Nunca incluir service_role, secret key, DATABASE_URL o secretos IA en EXPO_PUBLIC_*.

