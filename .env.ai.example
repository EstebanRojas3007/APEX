# Dedicated backend only. Copy to .env.ai; never use EXPO_PUBLIC_*.
APEX_AI_SUPABASE_URL=
APEX_AI_SUPABASE_SERVICE_KEY=
# Published n8n HTTPS webhook. Header Auth: Authorization: Bearer <token>.
APEX_AI_N8N_URL=
APEX_AI_N8N_TOKEN=
# Gemini credentials/model live in n8n credential storage, never in Expo.
