# Copy to supabase/functions/.env.local for local serving only. Never commit values.
# SUPABASE_URL is injected by the runtime. Set explicitly only in isolated tests.
APEX_ADMIN_SUPABASE_PUBLISHABLE_KEY=
APEX_ADMIN_SUPABASE_SERVICE_KEY=
APEX_ADMIN_INVITE_REDIRECT_URL=http://localhost:8081/auth/invite
APEX_ADMIN_EXISTING_INVITE_REDIRECT_URL=http://localhost:8081/auth/invite
APEX_ADMIN_ALLOWED_ORIGINS=http://localhost:8081
# Example sender: remitente@example.invalid; scope gmail.send, with offline access.
# These values remain exclusively in Edge secrets. No Gmail account password.
APEX_ADMIN_GMAIL_CLIENT_ID=
APEX_ADMIN_GMAIL_CLIENT_SECRET=
APEX_ADMIN_GMAIL_REFRESH_TOKEN=
