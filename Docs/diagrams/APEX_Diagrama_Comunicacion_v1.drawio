        <mxCell id="t4" value="1 [conexión restablecida]:&lt;br&gt;solicitarReanudación()" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;fillColor=none;strokeColor=none;">
