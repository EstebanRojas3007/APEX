        <mxCell id="F" value="«control»&lt;br&gt;&lt;u&gt;&lt;b&gt;acceso:&lt;br&gt;ControlAcceso&lt;/b&gt;&lt;/u&gt;" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=18;spacing=12;">
