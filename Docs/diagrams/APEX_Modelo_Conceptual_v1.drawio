        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Resultado de evaluación&lt;/b&gt;&lt;br&gt;Aciertos · desempeño por núcleo&lt;br&gt;Estimación inicial en el diagnóstico" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="520" y="740" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge5" value="Produce 0..1 resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#334155;strokeColor=#64748B;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;endArrow=none;" parent="1" source="attempt" target="result" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;REGLAS CONFIRMADAS Y PENDIENTES&lt;/b&gt;&lt;br&gt;Un intento por estudiante y evaluación asignada; se permiten nuevas evaluaciones. Se puede retroceder.&lt;br&gt;Diagnóstico: 7 preguntas sin límite total. Cuestionario específico: 15 preguntas / 30 minutos.&lt;br&gt;Reanudar tras desconexión conserva el mismo intento. Pendientes: cronómetro, plazo de retorno y fórmula de nivel." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="70" y="920" width="1270" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
