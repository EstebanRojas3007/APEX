  <diagram id="p5" name="05 · Alcance y reglas">
    <mxGraphModel dx="1213" dy="828" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="APEX · MODELO CONCEPTUAL" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=26;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1320" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Notas de interpretación. Las reglas temporales detalladas se desarrollarán en los diagramas de actividades, secuencia y estados." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="66" width="1320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Vista 5 · Versión 1.0 · 25 septiembre 2026 · Modelo del dominio independiente de la tecnología" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="1050" width="1320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;ALCANCE DEL MODELO&lt;/b&gt;&lt;br&gt;Modelo conceptual del dominio, independiente del diagrama de clases detallado y del MER.&lt;br&gt;Conceptos y relaciones del negocio, sin tipos de programación, métodos, PK ni FK.&lt;br&gt;Conceptos repetidos entre páginas representan el mismo concepto.&lt;br&gt;La notación de generalización conserva Usuario como clase abstracta; no se presupone exclusividad de roles.&lt;br&gt;Una institución y un componente en el MVP." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="60" y="150" width="620" height="245" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;REGLAS CONFIRMADAS&lt;/b&gt;&lt;br&gt;Fuera de evaluaciones: bloqueo de sesión a los 90 segundos y nueva verificación de identidad.&lt;br&gt;En evaluación: alerta a los 5 min; cuenta regresiva a los 7; bloqueo a los 8. Incluir entrada táctil.&lt;br&gt;Cinco accesos fallidos: bloqueo de cuatro minutos; falta definir ventana de conteo.&lt;br&gt;Confirmaciones en acciones críticas y doble confirmación antes de iniciar una evaluación." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="720" y="150" width="620" height="245" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="&lt;b&gt;DECISIONES ABIERTAS&lt;/b&gt;&lt;br&gt;• Elegir Inglés o Razonamiento Cuantitativo.&lt;br&gt;• Fórmula de calificación y rangos de estimación de nivel.&lt;br&gt;• Reglas del cronómetro y plazo de recuperación por desconexión.&lt;br&gt;• Consecuencia definitiva del bloqueo por inactividad.&lt;br&gt;• Fuente oficial, formato y duración del simulacro general.&lt;br&gt;• Taxonomía componente / competencia / núcleo temático.&lt;br&gt;• Retención de chats, resultados, registros de acceso y alcance de los seis meses.&lt;br&gt;• Límites de espera para guardar respuestas y responder desde IA.&lt;br&gt;• Fuentes autorizadas para la IA y criterios de cita.&lt;br&gt;• Detalles de asignación docente y tutorías." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="60" y="450" width="620" height="375" as="geometry" />
        </mxCell>
        <mxCell id="tech" value="&lt;b&gt;CONTEXTO TÉCNICO · NO ES PARTE DEL DOMINIO&lt;/b&gt;&lt;br&gt;React Native / Expo para la app.&lt;br&gt;Gemini API y n8n local para el flujo de IA.&lt;br&gt;Firebase está integrado en el prototipo.&lt;br&gt;PostgreSQL / Supabase es una alternativa recomendada, no una migración confirmada.&lt;br&gt;La elección tecnológica no cambia estas relaciones conceptuales." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="720" y="450" width="620" height="185" as="geometry" />
        </mxCell>
        <mxCell id="quality" value="&lt;b&gt;CALIDAD Y DATOS&lt;/b&gt;&lt;br&gt;Objetivo de accesibilidad: WCAG 2.2 AA. Capacidad inicial: 7 usuarios simultáneos.&lt;br&gt;Carga de preguntas: máximo 60 s con estado visible. Resultados: objetivo de 30 s, sin espera artificial.&lt;br&gt;Historial académico para el estudiante. Resultados para estudios posteriores: anonimización y retención pendientes.&lt;br&gt;Eliminar cuenta incluye identidad de acceso, perfil, progreso e historial de IA; aclarar resultados de estudio y copias de respaldo." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="720" y="675" width="620" height="245" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Leyenda: azul = identidad y estructura; verde = actividad académica; violeta = análisis y acompañamiento; ámbar = administración o decisiones abiertas.&#xa;Las asociaciones sin multiplicidad requieren especificación posterior; no representan automáticamente relaciones de una base de datos." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
          <mxGeometry x="60" y="950" width="1280" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
