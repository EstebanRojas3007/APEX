          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="txt2" value="MATERIAL_NUCLEO mantiene varios núcleos por material y evita duplicar la misma asociación. Se elimina MATERIAL_FUENTE: id_fuente guarda una sola fuente principal por material. Puede ser nulo en borrador, pero es&lt;br&gt;obligatorio al publicar. ubicacion es una referencia al recurso.&lt;br&gt;FUENTE se comparte entre materiales, preguntas y citas IA. Esta simplificación limita la bibliografía estructurada a una fuente principal por recurso; si se requieren varias, se recupera la tabla intermedia. Los&lt;br&gt;desarrolladores gestionan el contenido inicialmente." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=none;">
          <mxGeometry x="60" y="605" width="2040" height="132" as="geometry" />
        </mxCell>
        <mxCell id="txt3" value="PK: clave primaria (varios campos PK forman una clave compuesta). FK: clave foránea. UQ: unicidad. ?: admite nulo; el resto es obligatorio.&lt;br&gt;Tipos lógicos: id, texto, entero, booleano, fecha, instante y estado. No son tipos SQL. [p.NN] indica dónde está definida la tabla de destino.&lt;br&gt;Cada tabla se define completa una sola vez. Flecha: tabla dependiente → tabla referenciada. Propuesta simplificada de 32 tablas · Versión 1.1 · 25/09/2026." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="60" y="761" width="2040" height="100" as="geometry" />
        </mxCell>
      </root>
