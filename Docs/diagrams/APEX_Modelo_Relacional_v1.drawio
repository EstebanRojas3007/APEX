        <mxCell id="edge3" source="NUCLEO_TEMATICO" target="COMPONENTE" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;exitX=1;exitY=0.72;entryX=1;entryY=0.72;">
          <mxGeometry relative="1" as="geometry">
