          <mxGeometry x="800" y="581" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="txt5" value="VISTA DERIVADA · no es una tabla&lt;br&gt;Recorre todos los ítems de la evaluación y sus preguntas.&lt;br&gt;Enlaza las respuestas del intento.&lt;br&gt;Agrupa por estudiante, resultado y PREGUNTA.id_nucleo: total,&lt;br&gt;aciertos, porcentaje y fecha." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=none;">
          <mxGeometry x="800" y="645" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="txt6" value="&lt;b&gt;V_PROGRESO_COMPETENCIA&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=none;">
          <mxGeometry x="1540" y="581" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="txt7" value="VISTA DERIVADA · no es una tabla&lt;br&gt;Usa el mismo recorrido y agrupa por estudiante, resultado y&lt;br&gt;PREGUNTA.id_competencia.&lt;br&gt;Incluye ítems no contestados. Compara evaluaciones con&lt;br&gt;alcance y reglas compatibles." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=none;">
          <mxGeometry x="1540" y="645" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="txt8" value="Se eliminan las tablas DETALLE_RESULTADO_NUCLEO y DETALLE_RESULTADO_COMPETENCIA. RESULTADO conserva el resumen global; las vistas calculan los desgloses recorriendo RESULTADO → INTENTO →&lt;br&gt;ASIGNACION_EVALUACION → EVALUACION → ITEM_EVALUACION → PREGUNTA y enlazando RESPUESTA por intento e ítem.&lt;br&gt;Partir de todos los ítems y hacer LEFT JOIN con RESPUESTA: una pregunta no contestada cuenta en el total y aporta cero aciertos. Calcular porcentajes con aritmética decimal. Para reproducir niveles por categoría,&lt;br&gt;conservar preguntas, opciones, clasificación y la implementación de version_regla. Solo agrupar intentos finalizados que tengan resultado; no borrar respuestas mientras se deba conservar este historial." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=none;">
          <mxGeometry x="60" y="911" width="2040" height="132" as="geometry" />
        </mxCell>
        <mxCell id="txt9" value="PK: clave primaria (varios campos PK forman una clave compuesta). FK: clave foránea. UQ: unicidad. ?: admite nulo; el resto es obligatorio.&lt;br&gt;Tipos lógicos: id, texto, entero, booleano, fecha, instante y estado. No son tipos SQL. [p.NN] indica dónde está definida la tabla de destino.&lt;br&gt;Cada tabla se define completa una sola vez. Flecha: tabla dependiente → tabla referenciada. Propuesta simplificada de 32 tablas · Versión 1.1 · 25/09/2026." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="60" y="1067" width="2040" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
