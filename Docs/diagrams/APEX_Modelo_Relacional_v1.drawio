        <mxCell id="edge0" source="OPCION_RESPUESTA" target="PREGUNTA" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.2894190871369295;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="txt2" value="Propuesta simplificada: una fuente principal, un núcleo y una competencia por pregunta. Se eliminan sus tres tablas puente y se agregan FK directas a PREGUNTA. Se admiten nulos solo durante el borrador. Núcleo y&lt;br&gt;competencia deben pertenecer al mismo componente, incluido en la evaluación que use la pregunta; son validaciones cruzadas del servidor.&lt;br&gt;MVP propuesto de respuesta única: publicar exige opciones ordenadas y exactamente una correcta. es_correcta y explicacion no se envían durante el intento. Cada versión tiene ID propio y se congela junto con opciones y&lt;br&gt;clasificación antes de asignar la evaluación. Si el banco exige varias competencias o núcleos por pregunta, hay que recuperar esas tablas puente." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=none;">
          <mxGeometry x="60" y="737" width="2040" height="132" as="geometry" />
        </mxCell>
        <mxCell id="txt3" value="PK: clave primaria (varios campos PK forman una clave compuesta). FK: clave foránea. UQ: unicidad. ?: admite nulo; el resto es obligatorio.&lt;br&gt;Tipos lógicos: id, texto, entero, booleano, fecha, instante y estado. No son tipos SQL. [p.NN] indica dónde está definida la tabla de destino.&lt;br&gt;Cada tabla se define completa una sola vez. Flecha: tabla dependiente → tabla referenciada. Propuesta simplificada de 32 tablas · Versión 1.1 · 25/09/2026." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="60" y="893" width="2040" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
