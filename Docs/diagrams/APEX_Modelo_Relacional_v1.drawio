              <mxPoint x="1387" y="402" />
              <mxPoint x="2127" y="402" />
              <mxPoint x="2127" y="312.4" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="txt2" value="PROGRAMA_COMPONENTE resuelve la relación N:M. COMPETENCIA y NUCLEO_TEMATICO tienen su propia identidad y pertenecen a un componente; no son términos intercambiables. Esta estructura del catálogo se debe&lt;br&gt;contrastar con el componente ICFES elegido.&lt;br&gt;MVP de una sola compañía: no se añade una tabla de organizaciones ni aislamiento multiinstitución. Un solo componente activo inicialmente; Inglés o Razonamiento Cuantitativo sigue por decidir." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=none;">
          <mxGeometry x="60" y="717" width="2040" height="108" as="geometry" />
        </mxCell>
        <mxCell id="txt3" value="PK: clave primaria (varios campos PK forman una clave compuesta). FK: clave foránea. UQ: unicidad. ?: admite nulo; el resto es obligatorio.&lt;br&gt;Tipos lógicos: id, texto, entero, booleano, fecha, instante y estado. No son tipos SQL. [p.NN] indica dónde está definida la tabla de destino.&lt;br&gt;Cada tabla se define completa una sola vez. Flecha: tabla dependiente → tabla referenciada. Propuesta simplificada de 32 tablas · Versión 1.1 · 25/09/2026." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=12;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="60" y="849" width="2040" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
