        <mxCell id="t1" value="02 · Organización del contenido — Programas, competencias, núcleos y recursos." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=none;strokeColor=none;">
