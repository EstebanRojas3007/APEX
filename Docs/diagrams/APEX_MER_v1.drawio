  <diagram id="mer1" name="01 · Identidad e incorporación">
    <mxGraphModel dx="1700" dy="1510" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1510" pageScale="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t0" value="&lt;b&gt;APEX · MODELO ENTIDAD–RELACIÓN&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=28;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="50" y="20" width="1590" height="45" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="01 · Identidad e incorporación — Perfiles especializados y control de invitaciones." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="50" y="85" width="1590" height="55" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="USUARIO representa el perfil de una identidad de autenticación externa. No contiene contraseñas ni sus confirmaciones. Fecha de nacimiento: obligatoria.&lt;br&gt;Cada perfil especializado pertenece a un único usuario; su identificador se hereda de USUARIO. Las cardinalidades no imponen exclusividad de roles.&lt;br&gt;Propuesta a validar: permitir perfiles combinados. Un administrador solo puede ser habilitado mediante una operación autorizada.&lt;br&gt;Invitación: correo autorizado, uso único y vencimiento. El secreto de invitación se protege; se modela su huella, no la contraseña del docente. Retención de eventos de acceso: pendiente." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=none;">
          <mxGeometry x="60" y="1235" width="1530" height="175" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Leyenda: ID = identificador conceptual; ? = dato opcional; 1 = exactamente uno; 0..1 = opcional; 0..* = cero o varios; 1..* = uno o varios.&lt;br&gt;Cardinalidad junto a una entidad: cuántas instancias de esa entidad corresponden a una instancia del otro extremo.&lt;br&gt;Las entidades repetidas en varias vistas son las mismas. Sin tipos SQL ni claves foráneas: se definirán en el modelo relacional. · Versión 1.0 · 25/09/2026" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;fillColor=none;strokeColor=none;">
          <mxGeometry x="60" y="1430" width="1540" height="70" as="geometry" />
