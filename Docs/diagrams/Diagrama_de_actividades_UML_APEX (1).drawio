lor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="1220" width="260" height="70" as="geometry"/></mxCell><mxCell id="save" value="Guardar modificación autorizada" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="835" y="1365" width="260" height="70" as="geometry"/></mxCell><mxCell id="health" value="Consultar estado de servicios&#xa;e incidencias" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="835" y="1510" width="260" height="70" as="geometry"/></mxCell><mxCell id="act" value="Atender incidencia dentro&#xa;de sus permisos" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="95" y="1655" width="260" height="70" as="geometry"/></mxCell><mxCell id="logout" value="Cerrar sesión" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="1800" width="260" height="70" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#243B53;strokeWidth=2;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="581" y="1945" width="28" height="28" as="geometry"/></mxCell><mxCell id="end_dot" value="" style="ellipse;fillColor=#243B53;strokeColor=#243B53;" vertex="1" parent="1"><mxGeometry x="587" y="1951" width="16" height="16" as="geometry"/></mxCell><mxCell id="note" value="Precondición: sesión administrativa. No se presupone acceso ilimitado a datos personales. Una modificación inválida no se persiste. El fin de esta actividad retorna a 01; la sesión ya se ha cerrado." style="shape=note;whiteSpace=wrap;html=0;align=left;spacing=14;fontSize=14;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="55" y="2050" width="1100" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="activity-6" name="06 Lectura y trazabilidad"><mxGraphModel page="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="note0" value="APEX · Guía de lectura del modelo de actividades UML" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=23;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note1" value="NOTACIÓN&#xa;Círculo negro: inicio. Círculo negro con anillo: fin de la actividad actual. Rectángulo redondeado: acción. Rombo con varias salidas: decisión; las guardas [condición] indican la alternativa. Rombo con varias entradas y una salida: fusión de caminos alternativos." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note2" value="RESPONSABILIDADES&#xa;Los carriles son particiones de actividad por responsable, no pantallas ni tablas. Las acciones siguen el flujo de control entre usuario, APEX y colaboradores. No se añadieron barras fork/join porque el alcance no exige tareas paralelas." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note3" value="CONTINUIDAD ENTRE ACTIVIDADES&#xa;01 invoca 02, 04 o 05 según rol y recibe el retorno al cerrar sesión. 02 invoca 03 para diagnóstico o simulacro y continúa en el dashboard al retornar. Las acciones violeta llevan marcador de invocación y vínculo interno a la pestaña destino." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note4" value="FUENTES Y ALCANCE&#xa;Derivado de Diagrama_de_procesos_APEX.drawio y de su trazabilidad a la propuesta PDF, mockup, casos de uso v2, clases v2 y secuencia del simulacro. Conserva los cinco recorridos del proceso anterior. El archivo de procesos y los UML previos no se modifican." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note5" value="PROPUESTAS QUE SIGUEN PENDIENTES&#xa;Registro público solo para estudiantes, diagnóstico inicial, validación del contenido, confirmación de tutoría, modalidades práctica/examen y contingencia de IA. No se fijan porcentajes ni umbrales de los tres niveles. Evaluación detallada: preguntas cerradas; textos abiertos requieren rúbrica propia." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note6" value="INTERPRETACIÓN DEL FIN&#xa;Finalizar 03 termina únicamente esa evaluación y retorna a quien la invocó; no cierra la sesión. El fin de 02, 04 o 05 ocurre después de cerrar sesión. Cancelar un diagnóstico no equivale a completarlo." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1020" height="115" as="geometry"/></mxCell><mxCell id="note7" value="ESTADO DEL ENTREGABLE&#xa;Propuesta de diseño funcional, no evidencia de implementación. El puntaje se calcula por reglas del sistema; la IA propone apoyo y personalización después de persistir los resultados. Antes de implementar se deben acordar las reglas académicas pendientes." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=15;fontSize=15;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="1020" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
