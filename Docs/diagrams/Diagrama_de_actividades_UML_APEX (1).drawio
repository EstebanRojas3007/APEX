" value="Preparar resumen, historial y&#xa;materiales autorizados para IA" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="1450" width="260" height="70" as="geometry"/></mxCell><mxCell id="generate" value="Generar propuesta de retroalimentación&#xa;y ruta de aprendizaje" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="835" y="1595" width="260" height="70" as="geometry"/></mxCell><mxCell id="validate" value="Validar disponibilidad y contenido&#xa;de la respuesta de IA" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="1740" width="260" height="70" as="geometry"/></mxCell><mxCell id="ok" value="¿Propuesta de IA válida?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="1885" width="260" height="100" as="geometry"/></mxCell><mxCell id="route" value="Guardar Retroalimentacion,&#xa;RutaAprendizaje y ModuloRuta" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="2030" width="260" height="70" as="geometry"/></mxCell><mxCell id="pending" value="Conservar resultados y ruta anterior;&#xa;marcar personalización pendiente" style="rounded=1;arcSize=20;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="465" y="2175" width="260" height="70" as="geometry"/></mxCell><mxCell id="merge_show" value="" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="583" y="2320"