 vertex="1" parent="1"><mxGeometry x="40" y="62" width="940" height="30" as="geometry"/></mxCell><mxCell id="s" value="Abrir panel administrativo" style="ellipse;fillColor=#E5F2EC;strokeColor=#4A8268;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="260" height="68" as="geometry"/></mxCell><mxCell id="menu" value="¿Qué desea gestionar?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="260" height="100" as="geometry"/></mxCell><mxCell id="users" value="Crear, activar o desactivar usuarios;&#xa;asignar roles autorizados" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="260" height="68" as="geometry"/></mxCell><mxCell id="catalog" value="Mantener competencias&#xa;y catálogos de apoyo" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="260" height="68" as="geometry"/></mxCell><mxCell id="health" value="Consultar incidencias y&#xa;estado de los servicios" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="450" width="260" height="68" as="geometry"/></mxCell><mxCell id="validation" value="Validar permisos, datos&#xa;e impacto de la modificación" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="635" width="260" height="68" as="geometry"/></mxCell><mxCell id="ok" value="¿Cambio válido?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="reject" value="Informar errores;&#xa;no aplicar la modificación" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="775" width="260" height="68" as="geometry"/></mxCell><mxCell id="save" value="Guardar cambios" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="960" width="260" height="68" as="geometry"/></mxCell><mxCell id="action" value="Atender incidencia dentro&#xa;de sus permisos" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="775" width="260" height="68" as="geometry"/></mxCell><mxCell id="more" value="¿Realizar otra tarea?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1090" width="260" height="100" as="geometry"/></mxCell><mxCell id="end" value="Cerrar sesión" style="ellipse;fillColor=#E5F2EC;strokeColor=#4A8268;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1280" width="260" height="68" as="geometry"/></mxCell><mxCell id="note" value="Las ramas administrativas provienen del modelo de casos de uso v2; no agregan acceso ilimitado a datos personales.&#xa;La validación de cambios se propone como control operativo. La modificación de roles no se ofrece al estudiante." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1410" width="920" height="100" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s" target="menu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="Usuarios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="users"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="Catálogos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="Supervisión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="health"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="validation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="validation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validation" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ok" target="reject"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="Corregir" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reject" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="809"/><mxPoint x="25" y="190"/><mxPoint x="510" y="190"/></Array></mxGeometry></mxCell><mxCell id="edge9" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ok" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="save" target="more"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="health" target="action"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="action" target="more"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="more" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="1140"/><mxPoint x="995" y="190"/><mxPoint x="510" y="190"/></Array></mxGeometry></mxCell><mxCell id="edge14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="more" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="process-6" name="06 Criterios y trazabilidad"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1020" pageHeight="1505"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="APEX · 06 Criterios y trazabilidad" style="text;html=0;fontSize=24;fontStyle=1;fontColor=#243B53;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="940" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Alcance de esta propuesta · cómo se conecta con los entregables anteriores" style="text;html=0;fontSize=14;fontColor=#526778;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="940" height="30" as="geometry"/></mxCell><mxCell id="n0" value="Tipo de modelo&#xa;&#xa;Diagrama de flujo de procesos. Expresa actividades, decisiones y retornos; no sustituye el diagrama de secuencia ni pretende ser un modelo BPMN formal. Óvalo = inicio/fin; rectángulo = actividad; rombo = decisión; doble borde = subproceso o retorno indicado." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="110" width="890" height="140" as="geometry"/></mxCell><mxCell id="n1" value="Fuentes del proyecto&#xa;&#xa;Propuesta APEX (PDF), mockup de escritorio y diagramas v2 de casos de uso y clases, más la secuencia del simulacro. Los tres modelos UML se consultaron en esta revisión. No se modificaron los archivos anteriores." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="280" width="890" height="140" as="geometry"/></mxCell><mxCell id="n2" value="Continuidad funcional&#xa;&#xa;Se conservan acceso, diagnóstico, simulacros, tres niveles de dificultad, material, progreso, ruta adaptativa, tutor IA, acompañamiento docente y administración. Las interfaces pendientes no se presentan como funciones ya implementadas." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="450" width="890" height="140" as="geometry"/></mxCell><mxCell id="n3" value="Relación con las clases&#xa;&#xa;Evaluación: Simulacro, IntentoSimulacro, RespuestaEstudiante y ResultadoCompetencia. Personalización: Progreso, RutaAprendizaje, ModuloRuta, Retroalimentacion y MotorAdaptativoIA. Comunicación: Conversacion, Mensaje y Tutoria." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="620" width="890" height="140" as="geometry"/></mxCell><mxCell id="n4" value="Precisiones frente a modelos anteriores&#xa;&#xa;El registro estaba en la propuesta original, pero se omitió en casos de uso v2: se recupera aquí como propuesta de alineación. Un acceso fallido retorna al acceso y nunca al simulacro. El intento se crea antes de guardar respuestas; la IA interviene después de conservar los resultados." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="790" width="890" height="140" as="geometry"/></mxCell><mxCell id="n5" value="Decisiones propuestas por confirmar&#xa;&#xa;Registro público solo de estudiantes; asignación administrativa de roles; diagnóstico previo a la primera ruta; manejo de fallos de IA; modalidades práctica/examen; validación de contenido. No se fijan umbrales de dificultad, bloqueo de cuenta o aprobación sin acuerdo." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="960" width="890" height="140" as="geometry"/></mxCell><mxCell id="n6" value="Límites y siguientes ajustes&#xa;&#xa;Detalle principal de evaluación: preguntas cerradas, consistente con OpcionRespuesta. La evaluación de textos abiertos requiere un subproceso y una rúbrica propios. Definir las reglas adaptativas antes de implementar; incorporar después estas precisiones a los UML previos." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="1130" width="890" height="140" as="geometry"/></mxCell><mxCell id="n7" value="Lectura del documento&#xa;&#xa;01 acceso → 02 estudiante / 04 docente / 05 administrador. La página 02 invoca la evaluación de la página 03 y recibe el retorno. Las páginas 04 y 05 regresan a su menú o cierran sesión. Los conectores de retorno nombrados evitan flechas largas entre páginas." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="1300" width="890" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
