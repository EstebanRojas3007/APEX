xGeometry x="50" y="345" width="260" height="68" as="geometry"/></mxCell><mxCell id="rr" value="Completar recuperación mediante&#xa;enlace válido; reintentar si caduca" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="345" width="260" height="68" as="geometry"/></mxCell><mxCell id="login" value="Ingresar credenciales" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="460" width="260" height="68" as="geometry"/></mxCell><mxCell id="auth" value="Validar identidad y estado de cuenta" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="575" width="260" height="68" as="geometry"/></mxCell><mxCell id="valid" value="¿Acceso autorizado?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="260" height="100" as="geometry"/></mxCell><mxCell id="error" value="Informar error sin abrir sesión;&#xa;reintentar, recuperar o salir" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="705" width="260" height="68" as="geometry"/></mxCell><mxCell id="role" value="Consultar rol y permisos" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="260" height="68" as="geometry"/></mxCell><mxCell id="roles" value="¿Rol autorizado?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent