ry"/></mxCell><mxCell id="meet" value="Revisar mensajes y&#xa;programar tutorías" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="450" width="260" height="68" as="geometry"/></mxCell><mxCell id="feedback" value="Registrar retroalimentación&#xa;para el estudiante" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="260" height="68" as="geometry"/></mxCell><mxCell id="validate" value="¿Contenido completo&#xa;y académicamente válido?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="schedule" value="Comprobar disponibilidad y&#xa;acordar horario con el estudiante" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="620" width="260" height="68" as="geometry"/></mxCell><mxCell id="publish" value="Publicar contenido aprobado" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="790" width="260" height="68" as="geometry"/></mxCell><mxCell id="notify" value="Guardar feedback / tutoría y&#xa;ponerlo a disposición del estudiante" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="790" width="260" height="68" as="geometry"/></mxCell><mxCell id="more" value="¿Realizar otra tarea?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="965" width="260" height="100" as="geometry"/></mxCell><mxCell id="end" value="Cerrar sesión" style="ellipse;fillColor=#E5F2EC;strokeColor=#4A8268;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1150" width="260" height="68" as="geometry"/></mxCell><mxCell id="note" value="El docente accede únicamente a los estudiantes y funciones autorizados.&#xa;La gestión de preguntas y materiales se conserva del modelo de casos de uso v2.&#xa;La tutoría se programa: este proceso no supone que ya exista videollamada integrada." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1300" width="920" height="100" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s" target="menu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="Seguimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="students"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="Contenido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="content"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="Comunicación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="menu" target="meet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="students" target="feedback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="Guardar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="feedback" target="more"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="654"/><mxPoint x="25" y="1015"/></Array></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="validate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="No: corregir" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validate" target="content"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="655"/><mxPoint x="345" y="484"/></Array></mxGeometry></mxCell><mxCell id="edge8" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validate" target="publish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="meet" target="schedule"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=