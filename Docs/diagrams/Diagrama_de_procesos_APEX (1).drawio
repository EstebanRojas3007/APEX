arent="1"><mxGeometry x="380" y="440" width="260" height="68" as="geometry"/></mxCell><mxCell id="answer" value="Responder u omitir;&#xa;guardar respuesta y tiempo" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="550" width="260" height="68" as="geometry"/></mxCell><mxCell id="done" value="¿Finaliza, se agota el tiempo&#xa;o termina el cuestionario?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="665" width="260" height="105" as="geometry"/></mxCell><mxCell id="next" value="Seleccionar siguiente pregunta;&#xa;ajustar dificultad si es adaptativo" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="260" height="68" as="geometry"/></mxCell><mxCell id="score" value="Cerrar intento y calcular resultados&#xa;por competencia según reglas" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="830" width="260" height="68" as="geometry"/></mxCell><mxCell id="save" value="Guardar resultados y&#xa;actualizar Progreso" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="940" width="260" height="68" as="geometry"/></mxCell><mxCell id="ai" value="Solicitar a MotorAdaptativoIA&#xa;feedback y ruta con material disponible" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1050" width="260" height="68" as="geometry"/></mxCell><mxCell id="ok" value="¿Respuesta de IA válida&#xa;y disponible?" style="rhombus;fillColor=#FFF5DE;strokeColor=#B68939;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1165" width="260" height="105" as="geometry"/></mxCell><mxCell id="fallback" value="Conservar resultados y ruta previa;&#xa;marcar personalización pendiente" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="1180" width="260" height="68" as="geometry"/></mxCell><mxCell id="route" value="Guardar Retroalimentacion,&#xa;RutaAprendizaje y ModuloRuta" style="rounded=1;fillColor=#EEF3F8;strokeColor=#5B7FA5;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1330" width="260" height="68" as="geometry"/></mxCell><mxCell id="end" value="Mostrar resultados y volver&#xa;al dashboard (página 02)" style="ellipse;fillColor=#E5F2EC;strokeColor=#4A8268;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1450" width="260" height="68" as="geometry"/></mxCell><mxCell id="note" value="Propuestas de detalle: validar la salida de IA y reintentar después si falla; no bloquear la consulta de resultados.&#xa;Práctica: puede ofrecer pistas. Simulación de examen: resultados al finalizar, sin ayuda durante el intento.&#xa;Los criterios y umbrales de los tres niveles deben definirse; aquí no se inventan porcentajes." style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=14;whiteSpace=wrap;html=0;fontSize=14;fontColor=#243B53;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="1600" width="920" height="120" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#526778;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s" tar